---
import BaseLayout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Greeting from '../components/Greeting.astro';
import Timer from '../components/Timer.astro';
import Timeline from '../components/Timeline.astro';
import Venue from '../components/Venue/Venue.astro';
import DressCode from '../components/DressCode.astro';
import Gifts from '../components/Gifts.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer/Footer.astro';

const targetTimestamp = new Date('2026-07-25T14:30:00+03:00').getTime();

const date = new Date(targetTimestamp);
const monthNames = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'
];
const day = date.getDate();
const month = monthNames[date.getMonth()];
const year = date.getFullYear();
const weddingDate = `${day} ${month}`;
const weddingFullDate = `${day} ${month} ${year}`;

const venueImages = [
  `${import.meta.env.BASE_URL}place1.webp`,
  `${import.meta.env.BASE_URL}place2.webp`,
  `${import.meta.env.BASE_URL}place3.webp`,
  `${import.meta.env.BASE_URL}place4.webp`,
  `${import.meta.env.BASE_URL}place5.webp`,
  `${import.meta.env.BASE_URL}place6.webp`,
];
---

<BaseLayout title={`Свадьба Влада и Марии | ${weddingFullDate}`}>
  <Hero targetTimestamp={targetTimestamp} />
  <Greeting weddingDate={weddingDate}/>
  <Timer targetTimestamp={targetTimestamp} />
  <Timeline />
  <Venue images={venueImages} />
  <DressCode />
  <Gifts />
  <Contacts />
  <Footer weddingDate={weddingFullDate} />
</BaseLayout>
