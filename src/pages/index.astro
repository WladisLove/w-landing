---
import BaseLayout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Greeting from '../components/Greeting.astro';
import Timer from '../components/Timer.astro';
import Timeline from '../components/Timeline.astro';
import Venue from '../components/Venue/Venue.astro';
import DressCode from '../components/DressCode.astro';
import Gifts from '../components/Gifts.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer/Footer.astro';

const targetTimestamp = new Date(2026, 6, 25, 14, 30, 0).getTime();

const date = new Date(targetTimestamp);
const monthNames = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'
];
const day = date.getDate();
const month = monthNames[date.getMonth()];
const year = date.getFullYear();
const weddingDate = `${day} ${month} ${year}`;

const venueImages = [
  '/place1.webp',
  '/place2.webp',
  '/place3.webp',
  '/place4.webp',
  '/place5.webp',
  '/place6.webp',
];
---

<BaseLayout title={`Свадьба Влада и Марии | ${weddingDate}`}>
  <Hero targetTimestamp={targetTimestamp} />
  <Greeting />
  <Timer targetTimestamp={targetTimestamp} />
  <Timeline />
  <Venue images={venueImages} />
  <DressCode />
  <Gifts />
  <Contacts />
  <Footer weddingDate={weddingDate} />
</BaseLayout>