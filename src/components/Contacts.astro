<style>
  .contact-note {
    text-align: center;
    margin-top: 1rem;
    font-size: 1rem;
    opacity: 0.8;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-dark);
    background: var(--bg-card);
    padding: 0.7rem 1.5rem;
    border-radius: 3rem;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    font-weight: 500;
    will-change: transform;
  }

  .contact-item:hover {
    background: var(--accent);
    color: white;
    transform: translateY(-3px);
  }

  @media (max-width: 640px) {
    .contact-item {
      font-size: 0.9rem;
      padding: 0.5rem 1.2rem;
    }
  }
</style>

